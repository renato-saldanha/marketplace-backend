# Configurações do Marketplace API

# Aplicação
NOME_APLICACAO="Marketplace API"
VERSAO="1.0.0"
DEBUG=true

# Servidor
HOST="0.0.0.0"
PORTA=8000

# Banco de dados PostgreSQL
URL_BANCO_DADOS="postgresql://marketplace_user:marketplace_pass@localhost:5432/marketplace_db"

# Segurança
CHAVE_SECRETA="sua-chave-secreta-super-segura-aqui-mude-em-producao"
ALGORITMO="HS256"
TEMPO_EXPIRACAO_TOKEN=30

# Upload
TAMANHO_MAXIMO_ARQUIVO=5242880
PASTA_UPLOADS="uploads"

# CORS
ORIGENS_PERMITIDAS=["http://localhost:3000","http://127.0.0.1:3000"]
